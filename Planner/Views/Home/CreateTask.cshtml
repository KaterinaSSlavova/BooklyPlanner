@model CreateTaskViewModel
@{
    ViewData["Title"] = "Create Task";
}

<h2 class="mb-4">Create Reading Task</h2>
@Html.Partial("_Alert")

<form asp-controller="Home" asp-action="SaveTask" method="post">

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="DueDate" class="form-label">Due Date</label>
            <input asp-for="DueDate" type="date" class="form-control" />
            <span asp-validation-for="DueDate" class="text-danger"></span>
        </div>
    </div>

    <h4 class="mt-4">Book Info</h4>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Book.Title" class="form-label">Title</label>
            <input asp-for="Book.Title" class="form-control" />
            <span asp-validation-for="Book.Title" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Book.Author" class="form-label">Author</label>
            <input asp-for="Book.Author" class="form-control" />
            <span asp-validation-for="Book.Author" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Book.Image" class="form-label">Choose Picture</label>
            <input asp-for="Book.Image" type="file" class="form-control" />
            <span asp-validation-for="Book.Image" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Book.Pages" class="form-label">Pages</label>
            <input asp-for="Book.Pages" type="number" class="form-control" />
            <span asp-validation-for="Book.Pages" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Create Task</button>
</form>