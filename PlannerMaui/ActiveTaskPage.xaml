<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="TaskPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlannerMaui.ActiveTaskPage"
             Title="ActiveTaskPage">

    <CollectionView ItemsSource="{Binding Tasks}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="10" ColumnDefinitions="70,*,Auto,Auto" RowDefinitions="Auto">
                    <Image Source="{Binding Book.Image}" 
                           HeightRequest="90" WidthRequest="70" Aspect="AspectFit"
                           Grid.Column="0" />

                    <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Book.Title}" FontAttributes="Bold" />
                        <Label Text="{Binding DueDate, StringFormat='Due: {0:MM/dd/yyyy}'}" FontSize="Small" />
                    </StackLayout>

                    <Button Text="Complete" 
                            Grid.Column="2" 
                            VerticalOptions="Center"
                            BackgroundColor="Green" 
                            TextColor="White" 
                            Command="{Binding BindingContext.MarkAsComplete, Source={x:Reference TaskPage}}"
                            CommandParameter="{Binding Id}"/>

                    <Button Text="Archive" 
                            Grid.Column="3" 
                            VerticalOptions="Center"
                            BackgroundColor="Red" 
                            TextColor="White"
                             Command="{Binding BindingContext.ArchiveTask, Source={x:Reference TaskPage}}"
                             CommandParameter="{Binding Id}"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>